{
  "name": "subtitle-lab",
  "version": "0.5.1",
  "description": "An editable, scroll-synced Markdown subtitle study view for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "prepare-note": "node scripts/prepare.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
